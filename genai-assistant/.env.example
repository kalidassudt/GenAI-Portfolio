# Ollama needs no API key. When unavailable or disabled, the mock is used.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest

# LLM defaults; API requests can override temperature and max tokens.
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=600
LLM_REQUEST_TIMEOUT=30
GENAI_API_URL=http://127.0.0.1:8000