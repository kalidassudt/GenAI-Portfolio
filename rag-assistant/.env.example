# Ollama chat is optional; a local extractive answer is used if unavailable.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest

# Optional Ollama embedding model. Blank selects local hashing embeddings.
OLLAMA_EMBEDDING_MODEL=

# Retrieval configuration.
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120
RAG_RETRIEVAL_K=4